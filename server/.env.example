APP_NAME="PaCo Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite (database/database.sqlite) is enough for `php artisan serve`.
# MariaDB 10.6+ for everything else; compose.yaml always uses mariadb and
# reads DB_HOST..DB_PASSWORD from here (defaults: its bundled `db` service).
DB_CONNECTION=sqlite
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=paco
# DB_USERNAME=paco
# DB_PASSWORD=paco

# Docker Compose: start the bundled MariaDB container. Remove this line and set
# DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD to use an existing
# MariaDB server instead.
COMPOSE_PROFILES=mariadb

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="paco@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PaCo Cloud
# Device long-poll hold (s) and the number of polls held at once before
# devices are told to retry later. Keep proxy/PHP timeouts above the hold.
PACO_LONGPOLL_MAX_SECONDS=25
PACO_LONGPOLL_MAX_CONCURRENT=200
PACO_ENROLL_CODE_TTL_MINUTES=15

# Production (compose.prod.yaml)
# PACO_DOMAIN=paco.example.com
# OCTANE_WORKERS=32

# Browser notifications for new requests (Settings → Notifications).
# Generate once with `php artisan webpush:vapid`; leave empty to mail only.
VAPID_SUBJECT="mailto:${MAIL_FROM_ADDRESS}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
